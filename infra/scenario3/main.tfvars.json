{
  "location": "${AZURE_LOCATION}",
  "environment_name": "${AZURE_ENV_NAME}",
  "principal_id": "${AZURE_PRINCIPAL_ID}",
  "resource_group_name": "${AZURE_RESOURCE_GROUP}",
  "zone_redundancy_enabled": false,
  "network": {
    "virtual_network_name": "${AZURE_VIRTUAL_NETWORK_NAME}",
    "virtual_network_resource_group_name": "${AZURE_VIRTUAL_NETWORK_RESOURCE_GROUP_NAME}",
    "private_endpoint_subnet_name": "${AZURE_PRIVATE_ENDPOINT_SUBNET_NAME}",
    "apim_subnet_name": "${AZURE_APIM_SUBNET_NAME}",
    "app_service_environment_subnet_name": "${AZURE_APP_SERVICE_ENVIRONMENT_SUBNET_NAME}"
  },
  "apim": {
    "publisher_name": "${AZURE_APIM_PUBLISHER_NAME}",
    "publisher_email": "${AZURE_APIM_PUBLISHER_EMAIL}",
    "sku_name": "Developer",
    "sku_capacity": 1,
    "zones": []
  },
  "logic_app": {
    "sku_name": "I1v2",
    "worker_count": 1,
    "storage_account_account_tier": "Standard",
    "storage_account_account_replication_type": "LRS",
    "storage_account_file_share_quota": 10,
    "website_dns_server": "${AZURE_WEBSITE_DNS_SERVER}"
  },
  "function_app": {
    "sku_name": "I1v2",
    "worker_count": 1,
    "storage_account_account_tier": "Standard",
    "storage_account_account_replication_type": "LRS",
    "storage_account_file_share_quota": 10,
    "website_dns_server": "${AZURE_WEBSITE_DNS_SERVER}"
  },
  "file_storage_storage_account": {
    "account_tier": "Standard",
    "account_replication_type": "LRS"
  },
  "service_bus": {
    "sku_name": "Premium",
    "sku_capacity": 1
  },
  "app_configuration": {
    "sku": "standard"
  },
  "api_center": {
    "location": "${AZURE_API_CENTER_LOCATION}"
  }
}
